# ShiftPilot environment variables — copy to .env.local for development.
# See ENVIRONMENT.md for the full reference. Never commit real secrets.

# --- Required -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Server-only (never expose to the browser) ----------------------------
# Required for invitations to new users, shared rate limiting and background jobs.
SUPABASE_SERVICE_ROLE_KEY=
# Salt for hashing IPs/emails in rate-limit keys. Use a long random value.
IDENTIFIER_HASH_SALT=

# --- Optional integrations (features report "awaiting configuration" when unset)
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
